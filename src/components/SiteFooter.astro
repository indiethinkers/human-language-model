---
const sites = [
	{ href: 'https://techtwitter.com', label: 'Tech Twitter' },
	{ href: 'https://zeitgraphs.com', label: 'Zeitgraphs' },
	{ href: 'https://dansdimes.com', label: 'Dimes' },
	{ href: 'https://lgtm.news', label: 'LGTM' },
];
---

<footer class="site-footer">
	<p id="more-from-indie-thinkers" class="site-footer-heading">More from Indie Thinkers</p>
	<nav class="site-footer-links" aria-labelledby="more-from-indie-thinkers" data-plain-links>
		{
			sites.map((site, index) => (
				<span class="site-footer-item">
					{index > 0 && <span class="site-footer-sep" aria-hidden="true">//</span>}
					<a href={site.href}>{site.label}</a>
				</span>
			))
		}
	</nav>
</footer>

<style>
	.site-footer {
		flex-shrink: 0;
		margin: 0;
		padding: 0.85rem 1.25rem calc(3.15rem + env(safe-area-inset-bottom));
		background: var(--shiny-gray-50, #f8f8f6);
		color: var(--shiny-gray-500, oklch(55.1% 0.027 264.364));
		font-family: var(--font-geist-mono), 'Geist Mono', ui-monospace, monospace;
		font-size: 0.8125rem;
		font-weight: 400;
		line-height: 1.35;
		text-align: center;
	}

	.site-footer-heading {
		margin: 0 0 0.3rem;
		color: inherit;
		font: inherit;
		letter-spacing: 0.01em;
	}

	.site-footer-links {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: center;
		margin: 0;
		padding: 0;
		column-gap: 0.35rem;
		row-gap: 0.15rem;
	}

	.site-footer-item {
		white-space: nowrap;
	}

	.site-footer-sep {
		margin-right: 0.35rem;
	}

	.site-footer-links a {
		color: inherit;
		text-decoration: none;
	}

	.site-footer-links a:hover,
	.site-footer-links a:focus-visible {
		color: var(--shiny-gray-800, oklch(27.8% 0.033 256.848));
	}

	/* Essay pages pin a full-width corner bar to the bottom on small screens.
	   Keep this footer above that bar instead of sharing its padding band. */
	@media (max-width: 64rem) {
		:global(body.presentation-source) .site-footer {
			padding-bottom: 0.85rem;
			margin-bottom: calc(2.75rem + env(safe-area-inset-bottom));
		}
	}
</style>
