---
import { crossSiteLinks } from '../data/crossSiteLinks';
import { ALL_ESSAYS_HREF, SUBMIT_HREF, SUBSCRIBE_HREF } from '../consts';

interface Props {
	/** `fixed` for homepage-style corner chrome; `header` for essay sticky header */
	layout?: 'fixed' | 'header';
	menuId?: string;
}

const { layout = 'fixed', menuId = 'site-menu' } = Astro.props;
---

<div class:list={['site-menu-chrome', `site-menu-chrome--${layout}`]} data-site-menu>
	<nav class="nav-actions site-menu-quicklinks" aria-label="Site actions" data-menu-inert>
		<a href={SUBMIT_HREF} target="_blank" rel="noopener noreferrer" class="muted-link">
			submit
		</a>
		<span class="muted-text" aria-hidden="true">//</span>
		<a href={SUBSCRIBE_HREF} target="_blank" rel="noopener noreferrer" class="muted-link">
			subscribe
		</a>
	</nav>
	<span class="muted-text site-menu-toggle-sep" aria-hidden="true">//</span>
	<button
		type="button"
		class="menu-toggle muted-link"
		data-menu-toggle
		aria-expanded="false"
		aria-controls={menuId}
		aria-label="Open menu"
	>
		<span class="menu-toggle-label" data-menu-label>menu</span>
		<span class="menu-toggle-icon" data-menu-close-icon hidden aria-hidden="true">
			<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path
					d="M5 5L15 15M15 5L5 15"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"></path>
			</svg>
		</span>
	</button>
	<nav id={menuId} class="home-menu site-menu-panel" data-menu-panel hidden aria-label="Site">
		<div class="site-menu-backdrop" data-menu-backdrop aria-hidden="true"></div>
		<div class="site-menu-content">
			<a href={ALL_ESSAYS_HREF} class="home-menu-link">view all essays</a>
			<a href={SUBMIT_HREF} target="_blank" rel="noopener noreferrer" class="home-menu-link">
				submit
			</a>
			<a href={SUBSCRIBE_HREF} target="_blank" rel="noopener noreferrer" class="home-menu-link">
				subscribe
			</a>
			<div class="site-menu-divider" role="presentation"></div>
			<div class="site-menu-cross-links" data-plain-links>
				{
					crossSiteLinks.map((site) => (
						<a href={site.href} class="home-menu-link">{site.label}</a>
					))
				}
			</div>
		</div>
	</nav>
</div>

<script>
	import { initSiteMenu } from '../scripts/initSiteMenu.ts';
	initSiteMenu();
</script>

<style is:global>
	.site-menu-chrome {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--shiny-gray-500);
		font-size: 0.875rem;
		line-height: calc(1.25 / 0.875);
	}

	.site-menu-chrome--fixed {
		position: fixed;
		top: max(1rem, env(safe-area-inset-top));
		right: max(1rem, env(safe-area-inset-right));
		z-index: 50;
	}

	.site-menu-chrome--header {
		flex: 0 0 auto;
		gap: 0.375rem;
		white-space: nowrap;
	}

	.site-menu-quicklinks {
		display: none;
		gap: 0.5rem;
	}

	.site-menu-toggle-sep {
		display: none;
	}

	.menu-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		-webkit-appearance: none;
		appearance: none;
		margin: 0;
		padding: 0.5rem;
		border: 0;
		background: transparent;
		color: inherit;
		font: inherit;
		line-height: inherit;
		cursor: pointer;
	}

	.site-menu-chrome--fixed .menu-toggle {
		margin: -0.5rem;
	}

	.menu-toggle-icon {
		display: inline-flex;
		line-height: 0;
	}

	.menu-toggle-icon[hidden] {
		display: none;
	}

	.menu-toggle-label[hidden] {
		display: none;
	}

	.home-menu {
		position: fixed;
		inset: 0;
		z-index: 40;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
	}

	.home-menu[hidden] {
		display: none;
	}

	.site-menu-backdrop {
		position: absolute;
		inset: 0;
		background: color-mix(in srgb, var(--shiny-gray-50, #f8f8f6) 88%, transparent);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
	}

	.site-menu-content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
	}

	.home-menu-link {
		padding: 0.75rem 1rem;
		color: var(--shiny-gray-500);
		font-weight: 500;
		text-align: center;
		transition-duration: 0.15s;
		transition-property: color;
		transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
	}

	.home-menu-link:hover,
	.home-menu-link:focus-visible {
		color: var(--shiny-gray-800);
	}

	.site-menu-divider {
		width: min(12rem, 70vw);
		height: 1px;
		margin: 0.35rem 0 0.15rem;
		background: oklch(88% 0.01 264.364);
	}

	.site-menu-cross-links {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
	}

	body.menu-open {
		overflow: hidden;
	}

	body.menu-open .site-menu-chrome {
		z-index: 55;
	}

	@media (min-width: 1024px) {
		.site-menu-quicklinks {
			display: flex;
		}

		.site-menu-toggle-sep {
			display: inline;
		}
	}
</style>
