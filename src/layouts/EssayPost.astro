---
import type { CollectionEntry } from 'astro:content';
import { Font } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { authors } from '../data/authors';

type Props = CollectionEntry<'blog'>['data'] & {
	readingMinutes: number;
	sourcePath?: string;
};

const {
	title,
	description,
	deck,
	author = 'Daniel Hunter',
	authorSlug = 'daniel-hunter',
	copyrightHolder = author,
	license,
	pubDate,
	updatedDate,
	socialImage,
	presentation,
	titleMarkup,
	readingMinutes,
	sourcePath,
} = Astro.props;
const authorInfo = authors[authorSlug] ?? authors['daniel-hunter'];
const authorName = authorInfo?.name ?? author;
const licenseLabel = license === 'CC-BY-4.0' ? 'CC BY 4.0' : license;
const isSource = presentation === 'source';
const titleMarkTags = { '`': 'code', _: 'em' } as const;
const titleSegments = (titleMarkup ?? title)
	.split(/(`[^`]+`|_[^_]+_)/)
	.map((part, index) =>
		index % 2
			? { text: part.slice(1, -1), Tag: titleMarkTags[part[0] as keyof typeof titleMarkTags] }
			: { text: part },
	)
	.filter(({ text }) => text);
const toLocalIsoDate = (date: Date) => {
	const year = date.getFullYear();
	const month = String(date.getMonth() + 1).padStart(2, '0');
	const day = String(date.getDate()).padStart(2, '0');
	return `${year}-${month}-${day}`;
};
const isoDate = toLocalIsoDate(pubDate);
const isoUpdatedDate = updatedDate ? toLocalIsoDate(updatedDate) : undefined;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={socialImage} />
		{isSource && <Font cssVariable="--font-newsreader" preload />}
		{
			isSource && (
				<script is:inline>
					(() => {
						const run = () => {
							const status = document.querySelector('.source-status');
							const paragraphs = Array.from(
								document.querySelectorAll('.essay-body > p:not(.image-caption):not(.signoff)'),
							).filter((node) => node.textContent.trim().length > 0);

							paragraphs.forEach((paragraph, index) => {
								const number = index + 1;
								paragraph.id = 'p-' + number;
								const link = document.createElement('a');
								link.className = 'p-num';
								link.href = '#p-' + number;
								link.setAttribute('aria-label', 'Link to paragraph ' + number);
								link.textContent = String(number).padStart(2, '0');
								paragraph.prepend(link);
							});

							const pad = (value) => String(value).padStart(2, '0');
							let ticking = false;

							const updatePosition = () => {
								ticking = false;
								if (paragraphs.length === 0) return;

								const threshold = window.innerHeight * 0.35;
								let currentIndex = 0;

								for (let index = 0; index < paragraphs.length; index++) {
									if (paragraphs[index].getBoundingClientRect().top <= threshold) {
										currentIndex = index;
									}
								}

								const current = currentIndex + 1;

								if (status) {
									status.textContent = '¶ ' + pad(current) + ' / ' + pad(paragraphs.length);
									status.removeAttribute('hidden');
								}

								paragraphs.forEach((paragraph, index) => {
									const marker = paragraph.querySelector('.p-num');
									if (marker) marker.classList.toggle('is-current', index === currentIndex);
								});
							};

							const onScrollOrResize = () => {
								if (ticking) return;
								ticking = true;
								requestAnimationFrame(updatePosition);
							};

							window.addEventListener('scroll', onScrollOrResize, { passive: true });
							window.addEventListener('resize', onScrollOrResize, { passive: true });
							updatePosition();
						};

						if (document.readyState === 'loading') {
							document.addEventListener('DOMContentLoaded', run);
						} else {
							run();
						}
					})();
				</script>
			)
		}
	</head>

	<body class={isSource ? 'shiny-dimes-home presentation-source' : 'shiny-dimes-home'}>
		<main class="dime-page essay-detail-page">
			<header class="essay-page-header">
				<div class="site-label">
					<a href="/" class="muted-link">indie thinkers</a>
				</div>

				<nav class="nav-actions" aria-label="Essay actions">
					<a
						href="https://github.com/indiethinkers/human-language-model?tab=contributing-ov-file"
						target="_blank"
						rel="noopener noreferrer"
						class="muted-link"
					>
						submit
					</a>
					<span class="muted-text">//</span>
					<a
						href="http://indiethinkers.substack.com/subscribe"
						target="_blank"
						rel="noopener noreferrer"
						class="muted-link"
					>
						subscribe
					</a>
				</nav>
			</header>

			<div class="card-shell essay-detail-shell">
				<div class="quote-frame essay-detail-frame">
					<article class="quote-card essay-detail">
						{
							isSource ? (
								<header class="source-header">
									<div class="source-fence" aria-hidden="true">
										---
									</div>
									<h1 class="source-title">{titleSegments.map(({ text, Tag }) => (Tag ? <Tag>{text}</Tag> : text))}</h1>
									{deck && <p class="source-deck">{deck}</p>}
									<dl class="source-meta">
										<div>
											<dt>author</dt>
											<dd>
												<a href={`/authors/${authorInfo.slug}`}>{authorName}</a>
											</dd>
										</div>
										<div>
											<dt>published</dt>
											<dd>
												<time datetime={isoDate}>{isoDate}</time>
											</dd>
										</div>
										{isoUpdatedDate && (
											<div>
												<dt>updated</dt>
												<dd>
													<time datetime={isoUpdatedDate}>{isoUpdatedDate}</time>
												</dd>
											</div>
										)}
										<div>
											<dt>read</dt>
											<dd>{readingMinutes} min</dd>
										</div>
										<div>
											<dt>license</dt>
											<dd>
												<a href="https://creativecommons.org/licenses/by/4.0/">
													{licenseLabel}
												</a>
											</dd>
										</div>
									</dl>
									<div class="source-fence" aria-hidden="true">
										---
									</div>
								</header>
							) : (
								<header class="essay-header">
									<h1 class="essay-title">{title}</h1>
									<div class="essay-meta">
										<a href={`/authors/${authorInfo.slug}`} class="essay-byline">
											{authorName}
										</a>
										<span class="essay-meta-separator" aria-hidden="true">/</span>
										<span class="essay-date">
											<FormattedDate date={pubDate} />
											{
												updatedDate && (
													<span>
														{' '}
														/ updated <FormattedDate date={updatedDate} />
													</span>
												)
											}
										</span>
									</div>
									{deck && <p class="essay-deck">{deck}</p>}
								</header>
							)
						}

						<div class="essay-body">
							<slot />
						</div>

						{
							isSource ? (
								<>
									<div class="source-eof" aria-hidden="true">
										<span>~</span>
										<span>~</span>
										<span>~</span>
										<span>~</span>
										<span>~</span>
										<span>~</span>
									</div>
									<footer class="source-footer">
										<div class="source-footer-license">
											<p>
												© {pubDate.getFullYear()} {copyrightHolder} ·{' '}
												<a href="https://creativecommons.org/licenses/by/4.0/">
													{licenseLabel}
												</a>
											</p>
											<p>Third-party materials are excluded unless separately noted.</p>
										</div>
										{sourcePath && (
											<div class="source-footer-links">
												<a
													href={`https://github.com/indiethinkers/human-language-model/blob/main/${sourcePath}`}
												>
													view source ↗
												</a>
											</div>
										)}
									</footer>
								</>
							) : (
								<footer class="essay-license">
									<p>
										© {pubDate.getFullYear()} {copyrightHolder}.{' '}
										<a href="https://creativecommons.org/licenses/by/4.0/">
											Licensed under {licenseLabel}
										</a>.
									</p>
									<p>Third-party materials are excluded unless separately noted.</p>
								</footer>
							)
						}
					</article>
				</div>

				<div class="corner-links">
					{isSource && <div class="source-status" aria-hidden="true" hidden />}
					<div class="credit">
						<a href="/essays" class="credit-link">
							view all essays
						</a>
					</div>
				</div>
			</div>
		</main>

		<script is:inline>
			(() => {
				document.querySelectorAll('a[href]').forEach((link) => {
					const href = link.getAttribute('href');

					if (!href) return;

					try {
						const url = new URL(href, window.location.href);

						if (!['http:', 'https:'].includes(url.protocol)) return;
						if (url.origin === window.location.origin) return;

						link.target = '_blank';

						const relValues = new Set((link.rel || '').split(/\s+/).filter(Boolean));
						relValues.add('noopener');
						relValues.add('noreferrer');
						link.rel = Array.from(relValues).join(' ');
					} catch {
						// Ignore malformed hrefs and leave the original link behavior intact.
					}
				});

				const decks = document.querySelectorAll(
					".essay-body ul:has(img[alt^='Substack screenshot'])",
				);
				const stackLayouts = [
					{
						x: 'var(--substack-active-x)',
						y: 'var(--substack-active-y)',
						z: 'var(--substack-active-z)',
						rotate: 'var(--substack-active-rotation)',
						scale: '1',
						opacity: '1',
					},
					{
						x: 'var(--substack-second-x)',
						y: 'var(--substack-second-y)',
						z: '24px',
						rotate: 'var(--substack-second-rotation)',
						scale: '0.965',
						opacity: '0.94',
					},
					{
						x: 'var(--substack-third-x)',
						y: 'var(--substack-third-y)',
						z: '0px',
						rotate: 'var(--substack-third-rotation)',
						scale: '0.93',
						opacity: '0.88',
					},
					{
						x: 'var(--substack-fourth-x)',
						y: 'var(--substack-fourth-y)',
						z: '-22px',
						rotate: 'var(--substack-fourth-rotation)',
						scale: '0.895',
						opacity: '0.8',
					},
				];

				decks.forEach((deck) => {
					const cards = Array.from(deck.querySelectorAll(':scope > li')).filter((card) =>
						card.querySelector("img[alt^='Substack screenshot']"),
					);

					if (cards.length < 2) return;

					let activeIndex = 0;
					let pointerStart = null;

					deck.classList.add('substack-card-stack');
					deck.tabIndex = 0;
					deck.setAttribute('role', 'button');
					deck.setAttribute('aria-label', 'Flip through Substack screenshots');

					const resetDrag = () => {
						cards.forEach((card) => {
							card.style.setProperty('--active-drag-x', '0px');
							card.style.setProperty('--active-drag-rotation', '0deg');
						});
					};

					const renderStack = (nextIndex = activeIndex) => {
						activeIndex = (nextIndex + cards.length) % cards.length;

						cards.forEach((card, cardIndex) => {
							const stackPosition = (cardIndex - activeIndex + cards.length) % cards.length;
							const layout =
								stackLayouts[stackPosition] ??
								stackLayouts[stackLayouts.length - 1];

							card.classList.toggle('is-active', stackPosition === 0);
							card.style.setProperty('--stack-layer', `${cards.length - stackPosition}`);
							card.style.setProperty('--stack-offset-x', layout.x);
							card.style.setProperty('--stack-offset-y', layout.y);
							card.style.setProperty('--stack-z', layout.z);
							card.style.setProperty('--stack-rotation', layout.rotate);
							card.style.setProperty('--stack-scale', layout.scale);
							card.style.setProperty('--stack-opacity', layout.opacity);
						});
					};

					const updateTilt = (event) => {
						const rect = deck.getBoundingClientRect();
						const x = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
						const y = ((event.clientY - rect.top) / rect.height - 0.5) * 2;

						deck.style.setProperty('--deck-tilt-x', `${x * 4}deg`);
						deck.style.setProperty('--deck-tilt-y', `${y * -3}deg`);
					};

					let isAnimatingExit = false;

					const flip = (direction = 1, exitDirection = 0) => {
						if (isAnimatingExit) return;

						const dismissed = cards[activeIndex];

						if (exitDirection === 0 || !dismissed) {
							resetDrag();
							renderStack(activeIndex + direction);
							return;
						}

						isAnimatingExit = true;
						const flightDistance = Math.max(deck.offsetWidth, window.innerWidth) * 0.85;
						dismissed.dataset.exiting = 'true';
						dismissed.style.setProperty('--active-drag-x', `${exitDirection * flightDistance}px`);
						dismissed.style.setProperty('--active-drag-rotation', `${exitDirection * 22}deg`);

						setTimeout(() => {
							dismissed.dataset.snapping = 'true';
							delete dismissed.dataset.exiting;
							dismissed.style.setProperty('--active-drag-x', '0px');
							dismissed.style.setProperty('--active-drag-rotation', '0deg');
							renderStack(activeIndex + direction);
							requestAnimationFrame(() => {
								requestAnimationFrame(() => {
									delete dismissed.dataset.snapping;
									isAnimatingExit = false;
								});
							});
						}, 360);
					};

					deck.addEventListener('pointerdown', (event) => {
						if (isAnimatingExit) return;
						pointerStart = { x: event.clientX, y: event.clientY };
						deck.dataset.dragging = 'true';
						deck.setPointerCapture?.(event.pointerId);
					});

					deck.addEventListener('pointermove', (event) => {
						updateTilt(event);

						if (!pointerStart) return;

						const dragX = event.clientX - pointerStart.x;
						const activeCard = cards[activeIndex];

						activeCard?.style.setProperty('--active-drag-x', `${dragX * 0.55}px`);
						activeCard?.style.setProperty('--active-drag-rotation', `${dragX / 18}deg`);
					});

					deck.addEventListener('pointerup', (event) => {
						if (!pointerStart) return;

						const dragX = event.clientX - pointerStart.x;
						const dragY = event.clientY - pointerStart.y;
						const shouldSwipe = Math.abs(dragX) > 28 && Math.abs(dragX) > Math.abs(dragY);
						const shouldClick = Math.abs(dragX) < 8 && Math.abs(dragY) < 8;

						pointerStart = null;
						delete deck.dataset.dragging;

						if (shouldSwipe) {
							flip(dragX > 0 ? 1 : -1, dragX > 0 ? 1 : -1);
							return;
						}

						if (shouldClick) {
							flip(1, 1);
							return;
						}

						resetDrag();
					});

					deck.addEventListener('pointerleave', () => {
						deck.style.setProperty('--deck-tilt-x', '0deg');
						deck.style.setProperty('--deck-tilt-y', '0deg');
					});

					deck.addEventListener('keydown', (event) => {
						if (event.key === 'ArrowRight' || event.key === 'Enter' || event.key === ' ') {
							event.preventDefault();
							flip(1, 1);
						}

						if (event.key === 'ArrowLeft') {
							event.preventDefault();
							flip(-1, -1);
						}
					});

					renderStack();
				});

				const scrollPlayVideos = document.querySelectorAll('.scroll-play-video');

				if ('IntersectionObserver' in window) {
					const videoObserver = new IntersectionObserver(
						(entries) => {
							entries.forEach((entry) => {
								const video = entry.target;

								if (!(video instanceof HTMLVideoElement)) return;

								if (entry.isIntersecting) {
									video.play().catch(() => {});
									return;
								}

								video.pause();
							});
						},
						{ threshold: 0.35 },
					);

					scrollPlayVideos.forEach((video) => videoObserver.observe(video));
				} else {
					scrollPlayVideos.forEach((video) => {
						if (video instanceof HTMLVideoElement) video.play().catch(() => {});
					});
				}
			})();
		</script>
	</body>
</html>

<style is:global>
	@font-face {
		font-family: Geist;
		font-style: normal;
		font-weight: 100 900;
		font-display: swap;
		src: url('/fonts/geist-latin.woff2') format('woff2');
		unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
			U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191,
			U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
	}

	@font-face {
		font-family: 'Geist Mono';
		font-style: normal;
		font-weight: 100 900;
		font-display: swap;
		src: url('/fonts/geist-mono-latin.woff2') format('woff2');
		unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
			U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191,
			U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
	}

	@font-face {
		font-family: 'Geist Fallback';
		src: local('Arial');
		ascent-override: 95.94%;
		descent-override: 28.16%;
		line-gap-override: 0%;
		size-adjust: 104.76%;
	}

	@font-face {
		font-family: 'Geist Mono Fallback';
		src: local('Arial');
		ascent-override: 74.67%;
		descent-override: 21.92%;
		line-gap-override: 0%;
		size-adjust: 134.59%;
	}

	:root {
		--essay-content-width: 728px;
		--font-geist-sans: Geist, 'Geist Fallback', Arial, sans-serif;
		--font-geist-mono: 'Geist Mono', 'Geist Mono Fallback', Arial, monospace;
		--shiny-gray-50: oklch(98.5% 0.002 247.839);
		--shiny-gray-500: oklch(55.1% 0.027 264.364);
		--shiny-gray-700: oklch(37.3% 0.034 259.733);
		--shiny-gray-800: oklch(27.8% 0.033 256.848);
		--shiny-foreground: oklch(14.5% 0 0);
	}

	body.shiny-dimes-home {
		margin: 0;
		padding: 0;
		background: var(--shiny-gray-50);
		background-size: auto;
		color: var(--shiny-foreground);
		font-family: var(--font-geist-sans);
		font-size: 16px;
		line-height: 1.5;
		text-align: left;
		word-wrap: normal;
		overflow-wrap: normal;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	body.shiny-dimes-home *,
	body.shiny-dimes-home *::before,
	body.shiny-dimes-home *::after {
		box-sizing: border-box;
		border: 0 solid;
	}

	body.shiny-dimes-home a {
		color: inherit;
		text-decoration: inherit;
	}

	body.shiny-dimes-home img,
	body.shiny-dimes-home svg,
	body.shiny-dimes-home video,
	body.shiny-dimes-home canvas,
	body.shiny-dimes-home audio,
	body.shiny-dimes-home iframe,
	body.shiny-dimes-home embed,
	body.shiny-dimes-home object {
		display: block;
		vertical-align: middle;
	}

	.dime-page {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: auto;
		max-width: none;
		min-height: 100vh;
		margin: 0;
		padding: 0;
		background: var(--shiny-gray-50);
	}

	.card-shell {
		position: relative;
	}

	.corner-links {
		display: contents;
	}

	.essay-page-header {
		display: contents;
	}

	.site-label,
	.nav-actions,
	.shortcut-hint,
	.credit {
		position: fixed;
		color: var(--shiny-gray-500);
		font-size: 0.875rem;
		line-height: calc(1.25 / 0.875);
	}

	.site-label {
		top: 1rem;
		left: 1rem;
	}

	.nav-actions {
		top: 1rem;
		right: 1rem;
		display: flex;
		gap: 0.5rem;
	}

	.shortcut-hint {
		bottom: 2.75rem;
		left: 1rem;
	}

	.credit {
		right: 1rem;
		bottom: 1rem;
	}

	.muted-link,
	.credit-link,
	.essay-link {
		color: var(--shiny-gray-500);
		transition-duration: 0.15s;
		transition-property: color, background-color, border-color, outline-color, text-decoration-color,
			fill, stroke;
		transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
	}

	.credit-link {
		font-weight: 500;
	}

	.muted-link:hover,
	.essay-link:hover {
		color: var(--shiny-gray-700);
	}

	.credit-link:hover {
		color: var(--shiny-gray-800);
	}

	.quote-frame {
		width: 100%;
		max-width: 42rem;
		margin-inline: auto;
		padding-inline: 1rem;
	}

	.quote-card {
		display: flex;
		min-height: 150px;
		flex-direction: column;
		align-items: center;
		font-family: var(--font-geist-mono);
		opacity: 1;
		transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.essay-detail-page {
		align-items: flex-start;
		padding: 7rem 1rem 6rem;
	}

	.essay-detail-shell,
	.essay-detail-frame {
		width: 100%;
		max-width: calc(var(--essay-content-width) + 2rem);
	}

	.essay-detail {
		position: relative;
		min-height: auto;
		align-items: stretch;
		gap: 2rem;
		font-size: 0.9375rem;
		line-height: 1.8;
	}

	.essay-header {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.essay-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--shiny-gray-500);
		font-family: var(--font-geist-sans);
		line-height: 1.25;
	}

	.essay-byline {
		color: var(--shiny-gray-500);
