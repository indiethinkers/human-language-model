---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { authors } from '../data/authors';

type Props = CollectionEntry<'blog'>['data'];

const {
	title,
	description,
	deck,
	author = 'Daniel Hunter',
	authorSlug = 'daniel-hunter',
	pubDate,
	updatedDate,
} = Astro.props;
const authorInfo = authors[authorSlug] ?? authors['daniel-hunter'];
const authorName = authorInfo?.name ?? author;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body class="shiny-dimes-home">
		<main class="dime-page essay-detail-page">
			<div class="nav-actions">
				<a
					href="https://indiethinkers.dfos.com/"
					target="_blank"
					rel="noopener noreferrer"
					class="muted-link"
				>
					submit
				</a>
				<span class="muted-text">//</span>
				<a
					href="http://indiethinkers.substack.com/subscribe"
					target="_blank"
					rel="noopener noreferrer"
					class="muted-link"
				>
					subscribe
				</a>
			</div>

			<div class="card-shell essay-detail-shell">
				<div class="site-label">
					<a href="/" class="muted-link">indie thinkers</a>
				</div>

				<div class="quote-frame essay-detail-frame">
					<article class="quote-card essay-detail">
						<header class="essay-header">
							<h1 class="essay-title">{title}</h1>
							{deck && <p class="essay-deck">{deck}</p>}
							<a href={`/authors/${authorInfo.slug}`} class="essay-byline">
								<Image
									src={authorInfo.avatar}
									alt=""
									width={72}
									height={72}
									class="essay-author-avatar"
								/>
								<span class="essay-byline-copy">
									<span class="essay-author">{authorName}</span>
									<span class="essay-date">
										<FormattedDate date={pubDate} />
										{
											updatedDate && (
												<span>
													{' '}
													/ updated <FormattedDate date={updatedDate} />
												</span>
											)
										}
									</span>
								</span>
							</a>
						</header>

						<div class="essay-body">
							<slot />
						</div>
					</article>
				</div>

				<div class="credit">
					<a href="/essays" class="credit-link">
						view all essays
					</a>
				</div>
			</div>
		</main>
	</body>
</html>

<style is:global>
	@font-face {
		font-family: Geist;
		font-style: normal;
		font-weight: 100 900;
		font-display: swap;
		src: url('/fonts/geist-latin.woff2') format('woff2');
		unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
			U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191,
			U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
	}

	@font-face {
		font-family: 'Geist Mono';
		font-style: normal;
		font-weight: 100 900;
		font-display: swap;
		src: url('/fonts/geist-mono-latin.woff2') format('woff2');
		unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
			U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191,
			U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
	}

	@font-face {
		font-family: 'Geist Fallback';
		src: local('Arial');
		ascent-override: 95.94%;
		descent-override: 28.16%;
		line-gap-override: 0%;
		size-adjust: 104.76%;
	}

	@font-face {
		font-family: 'Geist Mono Fallback';
		src: local('Arial');
		ascent-override: 74.67%;
		descent-override: 21.92%;
		line-gap-override: 0%;
		size-adjust: 134.59%;
	}

	:root {
		--font-geist-sans: Geist, 'Geist Fallback', Arial, sans-serif;
		--font-geist-mono: 'Geist Mono', 'Geist Mono Fallback', Arial, monospace;
		--shiny-gray-50: oklch(98.5% 0.002 247.839);
		--shiny-gray-500: oklch(55.1% 0.027 264.364);
		--shiny-gray-700: oklch(37.3% 0.034 259.733);
		--shiny-gray-800: oklch(27.8% 0.033 256.848);
		--shiny-foreground: oklch(14.5% 0 0);
	}

	body.shiny-dimes-home {
		margin: 0;
		padding: 0;
		background: var(--shiny-gray-50);
		background-size: auto;
		color: var(--shiny-foreground);
		font-family: var(--font-geist-sans);
		font-size: 16px;
		line-height: 1.5;
		text-align: left;
		word-wrap: normal;
		overflow-wrap: normal;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	body.shiny-dimes-home *,
	body.shiny-dimes-home *::before,
	body.shiny-dimes-home *::after {
		box-sizing: border-box;
		border: 0 solid;
	}

	body.shiny-dimes-home a {
		color: inherit;
		text-decoration: inherit;
	}

	body.shiny-dimes-home img,
	body.shiny-dimes-home svg,
	body.shiny-dimes-home video,
	body.shiny-dimes-home canvas,
	body.shiny-dimes-home audio,
	body.shiny-dimes-home iframe,
	body.shiny-dimes-home embed,
	body.shiny-dimes-home object {
		display: block;
		vertical-align: middle;
	}

	.dime-page {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: auto;
		max-width: none;
		min-height: 100vh;
		margin: 0;
		padding: 0;
		background: var(--shiny-gray-50);
	}

	.card-shell {
		position: relative;
	}

	.site-label,
	.nav-actions,
	.shortcut-hint,
	.credit {
		position: fixed;
		color: var(--shiny-gray-500);
		font-size: 0.875rem;
		line-height: calc(1.25 / 0.875);
	}

	.site-label {
		top: 1rem;
		left: 1rem;
	}

	.nav-actions {
		top: 1rem;
		right: 1rem;
		display: flex;
		gap: 0.5rem;
	}

	.shortcut-hint {
		bottom: 1rem;
		left: 1rem;
	}

	.credit {
		right: 1rem;
		bottom: 1rem;
	}

	.muted-link,
	.credit-link,
	.essay-link {
		color: var(--shiny-gray-500);
		transition-duration: 0.15s;
		transition-property: color, background-color, border-color, outline-color, text-decoration-color,
			fill, stroke;
		transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
	}

	.credit-link {
		font-weight: 500;
	}

	.muted-link:hover,
	.essay-link:hover {
		color: var(--shiny-gray-700);
	}

	.credit-link:hover {
		color: var(--shiny-gray-800);
	}

	.quote-frame {
		width: 100%;
		max-width: 42rem;
		margin-inline: auto;
		padding-inline: 1rem;
	}

	.quote-card {
		display: flex;
		min-height: 150px;
		flex-direction: column;
		align-items: center;
		font-family: var(--font-geist-mono);
		opacity: 1;
		transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.essay-detail-page {
		align-items: flex-start;
		padding: 7rem 1rem 6rem;
	}

	.essay-detail-shell,
	.essay-detail-frame {
		width: 100%;
		max-width: 42rem;
	}

	.essay-detail {
		min-height: auto;
		align-items: stretch;
		gap: 2rem;
		font-size: 0.9375rem;
		line-height: 1.8;
	}

	.essay-header {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.essay-byline {
		display: inline-flex;
		align-items: center;
		align-self: flex-start;
		gap: 0.5rem;
		color: var(--shiny-gray-500);
		font-family: var(--font-geist-sans);
		line-height: 1.25;
		text-decoration: none;
		text-transform: uppercase;
	}

	.essay-author-avatar {
		width: 2.125rem;
		height: 2.125rem;
		flex: 0 0 2.125rem;
		border-radius: 999px;
		object-fit: cover;
	}

	.essay-byline-copy {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
	}

	.essay-author {
		margin: 0;
		color: var(--shiny-gray-800);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.075em;
	}

	.essay-date {
		display: block;
		margin: 0;
		color: var(--shiny-gray-500);
		font-size: 0.625rem;
		font-weight: 500;
		letter-spacing: 0.075em;
		line-height: calc(1.25 / 0.875);
	}

	.essay-byline:hover .essay-author {
		color: var(--shiny-foreground);
	}

	.essay-title {
		margin: 0;
		font-size: 1.875rem;
		font-weight: 500;
		letter-spacing: 0;
		line-height: 1.4;
	}

	.essay-header .essay-deck {
		width: 100%;
		margin: 0;
		padding: 0.875rem 0;
		border-top: 1px solid oklch(88% 0.01 264.364);
		border-bottom: 1px solid oklch(88% 0.01 264.364);
		color: var(--shiny-gray-500);
		font-size: 0.9375rem;
		font-weight: 400;
		letter-spacing: 0;
		line-height: 1.55;
	}

	.essay-body {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.essay-body :where(h2, h3, h4, p, blockquote, ul, ol, figure) {
		margin: 0;
	}

	.essay-body :where(h2, h3, h4) {
		margin-top: 1.75rem;
		font-weight: 700;
		letter-spacing: 0;
		line-height: 1.5;
	}

	.essay-body h2 {
		font-size: 1.5rem;
		line-height: 1.35;
	}

	.essay-body :where(h3, h4) {
		font-size: 1.125rem;
	}

	.essay-body > :first-child {
		margin-top: 0;
	}

	.essay-body .twitter-tweet {
		max-width: 100%;
		margin-block: 0.25rem;
		padding-left: 0;
		border-left: 0;
		color: inherit;
	}

	.essay-body a:not(:has(img)) {
		color: oklch(41% 0.08 238);
		font-weight: 600;
		text-decoration-line: underline;
		text-decoration-color: oklch(64% 0.07 238);
		text-decoration-thickness: 0.08em;
		text-underline-offset: 0.2em;
		transition-duration: 0.15s;
		transition-property: color, text-decoration-color, background-color;
		transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
	}

	.essay-body a:not(:has(img)):hover {
		background-color: oklch(94% 0.03 238);
		color: var(--shiny-foreground);
		text-decoration-color: currentColor;
	}

	.essay-body a:focus-visible {
		outline: 2px solid oklch(64% 0.07 238);
		outline-offset: 0.18em;
	}

	.essay-body a:has(img) {
		display: block;
		text-decoration: none;
	}

	.essay-body img {
		width: 100%;
		height: auto;
		margin-block: 0.5rem;
		border-radius: 0;
	}

	.essay-body blockquote {
		position: relative;
		margin-block: 0.125rem 0.375rem;
		padding: 0.85rem 0 0.9rem 2rem;
		border-block: 1px solid oklch(86% 0.018 247);
		border-left: 0;
		color: var(--shiny-foreground);
		font-size: 1.1875rem;
		font-weight: 500;
		letter-spacing: 0;
		line-height: 1.55;
	}

	.essay-body blockquote::before {
		content: '>';
		position: absolute;
		top: 0.85rem;
		left: 0;
		color: oklch(48% 0.06 238);
		font-weight: 700;
	}

	.essay-body blockquote :where(p) {
		margin: 0;
	}

	.essay-body :where(ul, ol) {
		padding-left: 1.25rem;
	}

	.essay-body ul:has(img[alt^='Substack screenshot']) {
		--substack-grid-width: min(56rem, calc(100vw - 2rem));

		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(0.5rem, 1vw, 0.875rem);
		width: var(--substack-grid-width);
		max-width: none;
		margin-block: 0.25rem 0.875rem;
		margin-inline: calc((100% - var(--substack-grid-width)) / 2);
		padding: 0;
		list-style: none;
	}

	.essay-body ul:has(img[alt^='Substack screenshot']) li {
		min-width: 0;
		margin: 0;
		background: transparent;
	}

	.essay-body ul:has(img[alt^='Substack screenshot']) img {
		width: 100%;
		margin: 0;
		background: transparent;
		filter: drop-shadow(0 0.875rem 1.75rem oklch(14.5% 0 0 / 12%));
	}
</style>
