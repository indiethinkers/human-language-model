		--substack-active-z: 48px;
		--substack-active-rotation: 16deg;
		--substack-second-x: 2rem;
		--substack-second-y: 1rem;
		--substack-second-rotation: 7deg;
		--substack-third-x: -4rem;
		--substack-third-y: 2.5rem;
		--substack-third-rotation: -5deg;
		--substack-fourth-x: -7rem;
		--substack-fourth-y: 4rem;
		--substack-fourth-rotation: 4deg;
		--deck-tilt-x: 0deg;
		--deck-tilt-y: 0deg;

		position: relative;
		display: block;
		width: var(--substack-stack-width);
		height: clamp(16rem, 36vw, 24rem);
		max-width: none;
		margin-block: 3rem 4rem;
		margin-inline: calc((100% - var(--substack-stack-width)) / 2);
		padding: 0;
		perspective: 1400px;
		perspective-origin: center;
		cursor: grab;
		isolation: isolate;
		list-style: none;
		touch-action: pan-y;
	}

	.essay-body ul:has(img[alt^='Substack screenshot']):focus-visible {
		outline: 2px solid oklch(64% 0.07 238);
		outline-offset: 0.35rem;
	}

	.essay-body ul:has(img[alt^='Substack screenshot'])[data-dragging='true'] {
		cursor: grabbing;
	}

	.essay-body ul:has(img[alt^='Substack screenshot']) li {
		--active-drag-rotation: 0deg;
		--active-drag-x: 0px;
		--stack-layer: 1;
		--stack-offset-x: 0px;
		--stack-offset-y: 0px;
		--stack-opacity: 1;
		--stack-rotation: 0deg;
		--stack-scale: 1;
		--stack-z: 0px;

		position: absolute;
		top: 50%;
		left: 50%;
		z-index: var(--stack-layer);
		width: var(--substack-card-width);
		min-width: 0;
		margin: 0;
		background: transparent;
		opacity: var(--stack-opacity);
		pointer-events: none;
		transform:
			translate3d(-50%, -50%, 0)
			translate3d(
				calc(var(--stack-offset-x) + var(--active-drag-x)),
				var(--stack-offset-y),
				var(--stack-z)
			)
			rotateX(var(--deck-tilt-y))
			rotateY(var(--deck-tilt-x))
			rotateZ(calc(var(--stack-rotation) + var(--active-drag-rotation)))
			scale(var(--stack-scale));
		transform-origin: 50% 80%;
		transition:
			opacity 260ms ease,
			filter 260ms ease,
			transform 520ms cubic-bezier(0.2, 0.85, 0.22, 1);
		will-change: transform;
	}

	.essay-body ul:has(img[alt^='Substack screenshot']) li:nth-child(1) {
		--stack-layer: 4;
		--stack-offset-x: var(--substack-active-x);
		--stack-offset-y: var(--substack-active-y);
		--stack-z: var(--substack-active-z);
		--stack-rotation: var(--substack-active-rotation);
		--stack-scale: 1;
	}

	.essay-body ul:has(img[alt^='Substack screenshot']) li:nth-child(2) {
		--stack-layer: 3;
		--stack-offset-x: var(--substack-second-x);
		--stack-offset-y: var(--substack-second-y);
		--stack-z: 24px;
		--stack-rotation: var(--substack-second-rotation);
		--stack-scale: 0.965;
		--stack-opacity: 0.94;
	}

	.essay-body ul:has(img[alt^='Substack screenshot']) li:nth-child(3) {
		--stack-layer: 2;
		--stack-offset-x: var(--substack-third-x);
		--stack-offset-y: var(--substack-third-y);
		--stack-z: 0px;
		--stack-rotation: var(--substack-third-rotation);
		--stack-scale: 0.93;
		--stack-opacity: 0.88;
	}

	.essay-body ul:has(img[alt^='Substack screenshot']) li:nth-child(4) {
		--stack-layer: 1;
		--stack-offset-x: var(--substack-fourth-x);
		--stack-offset-y: var(--substack-fourth-y);
		--stack-z: -22px;
