---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import EssayPost from '../../layouts/EssayPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);

const readingBody = (post.body ?? '')
	.replace(/<[^>]+>/g, ' ')
	.replace(/\]\([^)]+\)/g, ']');
const readingWords = readingBody
	.split(/\s+/)
	.filter((token) => /[\p{L}\p{N}]/u.test(token)).length;
const readingMinutes = Math.max(1, Math.round(readingWords / 230));
---

<EssayPost {...post.data} readingMinutes={readingMinutes} sourcePath={post.filePath}>
	<Content />
</EssayPost>
