---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';

const quoteEntries = (await getCollection('blog'))
	.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf())
	.map((post) => ({
		href: `/essays/${post.id}`,
		quote: post.data.quote,
	}));
const initialQuote = quoteEntries[0]?.quote ?? '';
const initialEssayHref = quoteEntries[0]?.href ?? '/essays';
const hasMultipleEssays = quoteEntries.length > 1;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Indie Thinkers"
			description="A curated collection of quotes from the brightest minds on the internet."
		/>
	</head>
	<body class="shiny-dimes-home">
		<main class="dime-page">
			<div class="nav-actions">
				<a
					href="https://github.com/indiethinkers/human-language-model"
					target="_blank"
					rel="noopener noreferrer"
					class="muted-link"
				>
					github
				</a>
				<span class="muted-text">//</span>
				<a
					href="http://indiethinkers.substack.com/subscribe"
					target="_blank"
					rel="noopener noreferrer"
					class="muted-link"
				>
					newsletter
				</a>
			</div>

			<div class="card-shell">
				<div class="site-label">
					<a href="/" class="muted-link">indie thinkers</a>
				</div>

				<div class="quote-frame">
					<div class="quote-card" data-quote-card data-quote-entries={JSON.stringify(quoteEntries)}>
						<div class="quote-text" data-quote={initialQuote}>
							<span data-quote-text></span><span class="type-cursor" data-type-cursor>&nbsp;</span>
						</div>
						<div class="essay-row">
							<a href={initialEssayHref} class="essay-link">
								(view essay)
							</a>
						</div>
					</div>
				</div>

				<div class="credit">
					<a href="/essays" class="credit-link">
						view all essays
					</a>
				</div>
			</div>

			{
				hasMultipleEssays && (
					<div class="shortcut-hint">
						<span class="desktop-hint">hit the spacebar for another essay</span>
						<span class="mobile-hint">double tap for another dime</span>
					</div>
				)
			}
		</main>

		<script>
			const quoteCard = document.querySelector('[data-quote-card]');
			const quoteElement = document.querySelector('[data-quote]');
			const quoteText = document.querySelector('[data-quote-text]');
			const cursor = document.querySelector('[data-type-cursor]');
			const essayLink = document.querySelector('.essay-link');
			const quoteEntries = JSON.parse(quoteCard?.getAttribute('data-quote-entries') ?? '[]');

			let typeTimeout = 0;
			let blinkInterval = 0;
			let cursorVisible = true;
			let isTransitioning = false;
			let lastTap = 0;
			let currentQuoteIndex = 0;

			const getCurrentQuoteEntry = () =>
				quoteEntries[currentQuoteIndex] ?? { href: '/essays', quote: '' };

			const syncEssayLink = () => {
				if (!essayLink) return;
				essayLink.href = getCurrentQuoteEntry().href;
			};

			const setCursorVisible = (visible) => {
				cursorVisible = visible;
				if (!cursor) return;
				cursor.style.backgroundColor = visible ? 'currentColor' : 'transparent';
				cursor.style.opacity = visible ? '0.7' : '0';
			};

			const stopBlinking = () => {
				if (blinkInterval) {
					window.clearInterval(blinkInterval);
					blinkInterval = 0;
				}
			};

			const startBlinking = () => {
				stopBlinking();
				blinkInterval = window.setInterval(() => {
					setCursorVisible(!cursorVisible);
				}, 530);
			};

			const resetEssayAnimation = () => {
				if (!essayLink) return;
				essayLink.classList.remove('essay-link');
				void essayLink.getBoundingClientRect();
				essayLink.classList.add('essay-link');
			};

			const typeQuote = () => {
				const quote = getCurrentQuoteEntry().quote;
				window.clearTimeout(typeTimeout);
				stopBlinking();
				setCursorVisible(true);
				syncEssayLink();
				if (quoteElement) quoteElement.style.opacity = '0';
				if (quoteText) quoteText.textContent = '';
				resetEssayAnimation();

				typeTimeout = window.setTimeout(() => {
					if (quoteElement) quoteElement.style.opacity = '1';
					let currentIndex = 0;

					const typeChar = () => {
						if (currentIndex < quote.length) {
							if (quoteText) quoteText.textContent = quote.slice(0, currentIndex + 1);
							currentIndex += 1;
							typeTimeout = window.setTimeout(typeChar, 70);
							return;
						}

						startBlinking();
					};

					typeChar();
				}, 50);
			};

			const replayQuote = () => {
				if (isTransitioning || !quoteCard || quoteEntries.length <= 1) return;
				isTransitioning = true;
				quoteCard.style.opacity = '0';

				window.setTimeout(() => {
					if (quoteEntries.length > 0) {
						currentQuoteIndex = (currentQuoteIndex + 1) % quoteEntries.length;
					}
					typeQuote();
					quoteCard.style.opacity = '1';
					isTransitioning = false;
				}, 300);
			};

			window.addEventListener('keydown', (event) => {
				if (event.code !== 'Space') return;
				event.preventDefault();
				replayQuote();
			});

			window.addEventListener('touchend', (event) => {
				const currentTime = Date.now();
				const tapLength = currentTime - lastTap;

				if (tapLength < 300 && tapLength > 0) {
					event.preventDefault();
					replayQuote();
				}

				lastTap = currentTime;
			});

			typeQuote();
		</script>
	</body>
</html>

<style is:global>
	@font-face {
		font-family: Geist;
		font-style: normal;
		font-weight: 100 900;
		font-display: swap;
		src: url('/fonts/geist-latin.woff2') format('woff2');
		unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
			U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191,
			U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
	}

	@font-face {
		font-family: 'Geist Mono';
		font-style: normal;
		font-weight: 100 900;
		font-display: swap;
		src: url('/fonts/geist-mono-latin.woff2') format('woff2');
		unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
			U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191,
			U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
	}

	@font-face {
		font-family: 'Geist Fallback';
		src: local('Arial');
		ascent-override: 95.94%;
		descent-override: 28.16%;
		line-gap-override: 0%;
		size-adjust: 104.76%;
	}

	@font-face {
		font-family: 'Geist Mono Fallback';
		src: local('Arial');
		ascent-override: 74.67%;
		descent-override: 21.92%;
		line-gap-override: 0%;
		size-adjust: 134.59%;
	}

	:root {
		--font-geist-sans: Geist, 'Geist Fallback', Arial, sans-serif;
		--font-geist-mono: 'Geist Mono', 'Geist Mono Fallback', Arial, monospace;
		--shiny-gray-50: oklch(98.5% 0.002 247.839);
		--shiny-gray-500: oklch(55.1% 0.027 264.364);
		--shiny-gray-700: oklch(37.3% 0.034 259.733);
		--shiny-gray-800: oklch(27.8% 0.033 256.848);
		--shiny-foreground: oklch(14.5% 0 0);
	}

	body.shiny-dimes-home {
		margin: 0;
		padding: 0;
		background: var(--shiny-gray-50);
		background-size: auto;
		color: var(--shiny-foreground);
		font-family: var(--font-geist-sans);
		font-size: 16px;
		line-height: 1.5;
		text-align: left;
		word-wrap: normal;
		overflow-wrap: normal;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	body.shiny-dimes-home *,
	body.shiny-dimes-home *::before,
	body.shiny-dimes-home *::after {
		box-sizing: border-box;
		border: 0 solid;
	}

	body.shiny-dimes-home a {
		color: inherit;
		text-decoration: inherit;
	}

	body.shiny-dimes-home img,
	body.shiny-dimes-home svg,
	body.shiny-dimes-home video,
	body.shiny-dimes-home canvas,
	body.shiny-dimes-home audio,
	body.shiny-dimes-home iframe,
	body.shiny-dimes-home embed,
	body.shiny-dimes-home object {
		display: block;
		vertical-align: middle;
	}

	.dime-page {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: auto;
		max-width: none;
		min-height: 100vh;
		margin: 0;
		padding: 0;
		background: var(--shiny-gray-50);
	}

	.card-shell {
		position: relative;
	}

	.site-label,
	.nav-actions,
	.shortcut-hint,
	.credit {
		position: fixed;
		color: var(--shiny-gray-500);
		font-size: 0.875rem;
		line-height: calc(1.25 / 0.875);
	}

	.site-label {
		top: 1rem;
		left: 1rem;
	}

	.nav-actions {
		top: 1rem;
		right: 1rem;
		display: flex;
		gap: 0.5rem;
	}

	.shortcut-hint {
		bottom: 1rem;
		left: 1rem;
	}

	.credit {
		right: 1rem;
		bottom: 1rem;
	}

	.muted-link,
	.credit-link,
	.essay-link {
		color: var(--shiny-gray-500);
		transition-duration: 0.15s;
		transition-property: color, background-color, border-color, outline-color, text-decoration-color,
			fill, stroke;
		transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
	}

	.credit-link {
		font-weight: 500;
	}

	.muted-link:hover,
	.essay-link:hover {
		color: var(--shiny-gray-700);
	}

	.credit-link:hover {
		color: var(--shiny-gray-800);
	}

	.quote-frame {
		width: 100%;
		max-width: 42rem;
		margin-inline: auto;
		padding-inline: 1rem;
		transform: translateY(clamp(-7rem, -11vh, -4rem));
	}

	.quote-card {
		display: flex;
		min-height: 150px;
		flex-direction: column;
		align-items: center;
		font-family: var(--font-geist-mono);
		opacity: 1;
		transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.quote-text {
		width: 100%;
		white-space: pre-wrap;
		text-align: center;
		font-family: var(--font-geist-mono);
		line-height: 1.625;
		opacity: 0;
		transition: opacity 1s ease-in-out;
	}

	.type-cursor {
		position: relative;
		top: -2px;
		display: inline-block;
		width: 0.4em;
		height: 1.2em;
		margin-bottom: -1px;
		margin-left: 1px;
		background-color: currentColor;
		vertical-align: middle;
		opacity: 0.7;
		transition: opacity 0.1s ease-in-out;
	}

	.essay-row {
		margin-top: 1.5rem;
	}

	.essay-link {
		font-size: 0.875rem;
		line-height: calc(1.25 / 0.875);
		opacity: 0;
		animation: fadeIn 2s ease-in-out forwards;
		animation-delay: 0.5s;
	}

	body.shiny-dimes-home .essay-row a {
		color: var(--shiny-gray-500);
	}

	.desktop-hint {
		display: none;
	}

	.mobile-hint {
		display: inline;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
		}

		to {
			opacity: 1;
		}
	}

	@media (min-width: 48rem) {
		.quote-frame {
			transform: translateY(clamp(-4rem, -6vh, -2rem));
		}

		.desktop-hint {
			display: inline;
		}

		.mobile-hint {
			display: none;
		}
	}
</style>
